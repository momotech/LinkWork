# Copy this file to .env and fill in real values.

# Backend / LiteLLM
ROBOT_LITELLM_API_KEY=
GITLAB_CLIENT_ID=
ROBOT_LITELLM_BASE_URL=
GITLAB_BASE_URL=
GITLAB_REDIRECT_URI=
BILLING_GATEWAY_URL_TEMPLATE=
TASK_SHARE_BASE_URL=

# Database
LINKWORK_DB_URL=

# Agent runtime config.json placeholders
