IMAGE_REGISTRY=

# Runtime gateway routes
API_BASE_URL=
WS_BASE_URL=
LLM_GATEWAY_URL=
LINKWORK_AGENT_MCP_GATEWAY_AGENT_BASE_URL=
LINKWORK_AGENT_MCP_GATEWAY_PROXY_BASE_URL=

# Other endpoints
MILVUS_URI=

# Optional local Maven/GitHub packages
GITHUB_TOKEN=
